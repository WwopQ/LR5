# ─── Скопируй этот файл в .env и заполни значения ───────────────────────────

# Django
SECRET_KEY=замени-на-длинную-случайную-строку
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# Логирование (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# PostgreSQL (для docker-compose и продакшена)
POSTGRES_DB=rentcar
POSTGRES_USER=rentcar_user
POSTGRES_PASSWORD=замени-на-сложный-пароль

# Для Render.com: вставь DATABASE_URL из Dashboard → Environment
# DATABASE_URL=postgresql://user:password@host:5432/dbname
